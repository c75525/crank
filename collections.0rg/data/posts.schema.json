{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collections.org post index",
  "type": "object",
  "required": ["posts"],
  "properties": {
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "publishedAt", "items"],
        "properties": {
          "id": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "publishedAt": { "type": "string", "format": "date" },
          "caption": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "position", "processedPath"],
              "properties": {
                "id": { "type": "string" },
                "position": { "type": "integer", "minimum": 1 },
                "processedPath": { "type": "string" },
                "responsiveSources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path", "width"],
                    "properties": {
                      "path": { "type": "string" },
                      "width": { "type": "integer", "minimum": 1 }
                    }
                  }
                },
                "intrinsicWidth": { "type": "integer", "minimum": 1 },
                "intrinsicHeight": { "type": "integer", "minimum": 1 },
                "sourceUrl": { "type": "string" },
                "description": { "type": "string" },
                "altText": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
